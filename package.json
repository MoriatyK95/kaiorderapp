{
  "name": "kaiorderapp",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal restaurant ordering demo built with React and Express, packaged in a single Docker container.",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2"
  }
}
